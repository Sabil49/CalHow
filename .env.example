# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# IMPORTANT: Expo inlines every EXPO_PUBLIC_* variable into the JS bundle at
# build time, so nothing secret can go here. Firebase client config is safe
# to expose (it's not a secret — access is controlled by Firestore security
# rules, not by hiding these values). AI provider keys, however, must live
# ONLY in the Next.js backend's server-side environment, never here.

# --- Firebase (safe to expose to the client) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- CalHow Next.js backend ---
# Base URL of the deployed Next.js app that hosts /api/meals/* routes.
#
# Local development — set this to match your environment:
#   iOS Simulator     : http://localhost:3000           (routes to Mac host correctly)
#   Android emulator  : http://10.0.2.2:3000            (emulator loopback → host machine)
#   Physical device   : http://<your-LAN-IP>:3000       (find with: ipconfig / ifconfig)
#
# Production: set this to your deployed Next.js URL (e.g. https://api.calhow.app).
# Never hard-code any of these values into the source — this env var is the only switch.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# --- RevenueCat (safe to expose to the client — these are PUBLIC SDK keys) ---
# From the RevenueCat dashboard -> Project Settings -> API Keys. These are
# per-platform PUBLIC keys (safe in a client bundle, like the Firebase
# config above) — NOT the same as the backend's RevenueCat SECRET key
# (calhow-backend/.env.local's REVENUECAT_SECRET_API_KEY), which must
# never appear here. See services/purchases.ts.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# --- Google Sign-In (safe to expose to the client — an OAuth client ID, not a secret) ---
# The "Web client (auto created by Google Service)" OAuth client ID that
# Firebase generates automatically once you enable Google as a sign-in
# provider in Firebase Console -> Authentication -> Sign-in method. Copy it
# from there, or from Google Cloud Console -> APIs & Services -> Credentials.
# See hooks/useSocialAuth.ts / services/auth.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
