rules_version = '2';

// CalHow Firestore Security Rules
//
// Data model (see services/firestore.ts / types/models.ts):
//   users/{uid}
//   users/{uid}/meals/{mealId}
//   users/{uid}/weightLogs/{weightLogId}
//   users/{uid}/corrections/{correctionId}
//
// Every path in this app is scoped by the owning user's uid as a path
// segment, so authorization is a single check: the signed-in caller's
// request.auth.uid must match that uid. This does not validate document
// *shape* (field types/required fields) — it only enforces ownership. The
// app's own TypeScript types are the source of truth for shape; adding
// schema validation here is a reasonable future hardening step but isn't
// required for the ownership guarantee requested.
//
// SERVER-ONLY PATH, DELIBERATELY GIVEN NO RULE HERE:
//   users/{uid}/scanUsage/{YYYY-MM-DD}  (see calhow-backend/services/usage/scanLimit.ts)
// This is the backend's authoritative free-tier daily AI-scan counter. It
// intentionally has NO nested `match` block below (unlike meals/
// weightLogs/corrections), so it falls through to the default-deny
// catch-all at the bottom of this file — the mobile client can never
// read OR write it directly, even though it lives under a path the user
// "owns". Only the backend's Firebase Admin SDK (which bypasses these
// rules entirely) can touch it. Do NOT add an `isOwner`-style rule for
// this path — that would let a user tamper with their own scan count.
// The same reasoning applies to `users/{uid}.subscription` becoming a
// verified-entitlement signal in the future: as long as `subscription` is
// writable under the `users/{uid}` rule below, the backend must not treat
// it as proof of a paid subscription (see
// calhow-backend/services/usage/entitlement.ts's doc comment).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /meals/{mealId} {
        allow read, write: if isOwner(uid);
      }

      match /weightLogs/{weightLogId} {
        allow read, write: if isOwner(uid);
      }

      match /corrections/{correctionId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Explicit default-deny for anything outside the paths above. This is
    // already Firestore's behavior when no rule matches, but is stated
    // here so the rules file is a complete, self-documenting picture of
    // what's accessible rather than relying on an implicit fallback.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
